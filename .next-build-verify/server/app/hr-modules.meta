{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/hr-modules/layout,_N_T_/hr-modules/page,_N_T_/hr-modules"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/hr-modules/__PAGE__",
    "/hr-modules",
    "/_index",
    "/_head"
  ]
}